---
import { SITE } from '../lib/site';

const qa = [
  {
    q: 'AngKorGit 还是 Angkor Git？',
    a: '一个词，AngKorGit。也有人写作 Angkor Git、angkorgit 或 GitAngkor，指的都是这个应用。angkorgit.app 是唯一的官方网站，代码托管在 GitHub 的 cheat2001/angkorgit 仓库。',
  },
  {
    q: '它真的免费吗？',
    a: '是的。MIT 许可，全部源代码都在 GitHub 上，没有任何隐藏在功能背后的付费层级。如果它为你节省了时间，页脚还有一个咖啡链接。',
  },
  {
    q: '为什么 macOS 在首次启动时警告我？',
    a: "The build isn't signed with an Apple developer certificate yet, so Gatekeeper asks once. Right-click and Open, or install through Homebrew, which clears the flag for you. After that the updater handles new versions and verifies each one with a signature.",
  },
  {
    q: '它会把任何数据发送出去吗？',
    a: '无遥测、无崩溃报告、无需账户。唯一的网络流量是 git 本身、针对 GitHub releases 的更新检查，以及你选择启用的 AI 提供方。',
  },
  {
    q: '它与 GitKraken 或 Fork 相比如何？',
    a: 'Faster to open, lighter, and narrower on purpose. GitKraken took the workflow ideas further than anyone and I learned from it, but I wanted the twenty-five features that matter rather than the hundred. Fork is closer in spirit, though it is not open source and not on Linux.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: qa.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />

<section class="border-t border-border-subtle py-20 lg:py-24">
  <div class="container-site rail-offset">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <div data-reveal>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-faint">常见问题</p>
        <h2 class="display mt-3 text-3xl leading-[1.05] sm:text-4xl">大家常问的问题</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-muted">
          Anything else, <a href={`${SITE.repo}/issues`} class="link-underline text-foreground">open an issue</a>. I read them all.
        </p>
      </div>
      <dl class="divide-y divide-border-subtle" data-reveal style={{ '--reveal-delay': '100ms' }}>
        {
          qa.map((item) => (
            <div class="grid gap-2 py-6 sm:grid-cols-[14rem_1fr] sm:gap-8">
              <dt class="text-[15px] font-medium text-foreground">{item.q}</dt>
              <dd class="text-[15px] leading-relaxed text-muted">{item.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
